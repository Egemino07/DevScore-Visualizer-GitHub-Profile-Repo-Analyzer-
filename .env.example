# GitHub personal access token — OPTIONAL but recommended.
# Without it the app has 60 API requests/hour (rate-limit fallback data);
# with it, 5,000 requests/hour of live data.
# Create one at https://github.com/settings/tokens (no scopes needed for public data)
# Copy this file to .env.local and paste YOUR OWN token below:
GITHUB_TOKEN=

# Optional: public origin for Open Graph metadata URLs (e.g. https://yourapp.vercel.app)
NEXT_PUBLIC_APP_URL=
